# Server config
PORT=3000
# DOMAIN=your-domain.com   # (dùng cho Caddy reverse proxy HTTPS)

# Messenger credentials
FB_PAGE_TOKEN=your_page_access_token
FB_PAGE_ID=your_page_id
FB_VERIFY_TOKEN=your_verify_token
FB_APP_SECRET=your_app_secret

# Encryption key (32 bytes hex)
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Database
MONGO_URI=mongodb://localhost:27017/school-bot

# Maximum accounts scraped at once in parallel mode (1-3; default 2)
SCRAPER_MAX_PARALLEL=2
# Do not scrape all accounts when npm start boots (opt in with true)
SCRAPER_SYNC_ON_START=false

# AI Settings
AI_PROVIDER=custom
CUSTOM_AI_URL=https://api.xah.io
CUSTOM_AI_KEY=sk-fd9b9e1238c55a1e034267163a5b4ec8fa72e8fa8b1516879ecfd7300896ebaf
CUSTOM_AI_MODEL=cuong5a115a11/deepseek-v4.1-flash
# OpenCode free tier requires the OpenCode client; leave as fallback only.
OPENCODE_API_KEY=public
OPENCODE_MODEL=mimo-v2.5-free
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Panel
ADMIN_PASSWORD=admin_strong_password

